# Copie para .env na VPS. Nunca faça commit das credenciais reais.
# Use um perfil WireGuard de provedor com saída de internet na Turquia.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820

# Gere uma chave aleatória longa (32 bytes ou mais). Não compartilhe.
PROXY_SIGNING_KEY=
